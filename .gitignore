# Derived data. This project builds into ./build via -derivedDataPath, so it is
# hundreds of megabytes of machine-specific output sitting inside the source tree.
build/

# Xcode per-user state: window layout, breakpoints, which scheme you last picked.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# macOS
.DS_Store

# Swift Package Manager
.swiftpm/
.build/
Packages/

# App Store screenshots: rendered output, tens of megabytes, remade with
# AppStore/seed-library.py and a simulator whenever the app changes.
AppStore/screenshots/

# The app's extraction scripts, copied into the Chrome extension by
# Extension/native/install-chrome-host.sh. The originals are in AmberGlow/Reader/Resources.
Extension/web/extract.js
Extension/web/defuddle.js
Extension/web/defuddle-run.js
Extension/web/defuddle-LICENSE.txt
