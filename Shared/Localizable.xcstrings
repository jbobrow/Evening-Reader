    "Some pages build their text after loading, and a few just aren't articles. You can still read it in the amber browser.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些頁面在載入後才產生文字，也有些頁面本來就不是文章。你仍可在琥珀色瀏覽器中閱讀。"
          }
        }
      }
    },
    "Something about this file's contents wasn't readable.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案的部分內容無法讀取。"
          }
        }
      }
    },
    "Something inside the file is too large to read.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
