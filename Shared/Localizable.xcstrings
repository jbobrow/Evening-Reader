    "A tour of Evening Reader": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening Reader 導覽"
          }
        }
      }
    },
    "A video fills the glass in either orientation, with simple controls of its own.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片無論直放或橫放都會填滿螢幕，並附有簡單的專屬控制項。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
