            "value": "搜尋"
          }
        }
      }
    },
    "Search above for something to read, or open one of your sites below. To keep a page or a book from another app, tap Share there and choose Evening Reader.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方搜尋想讀的內容，或打開下方的網站。要保留其他 App 中的頁面或書籍，請在該 App 中點一下「分享」並選擇 Evening Reader。"
          }
        }
      }
    },
    "Search from the front page for something to read, or tap Share in Safari or any other app and choose Evening Reader.": {
